  z-index: 1;
}

.coupon-card__rule {
  padding: 16rpx 24rpx 24rpx;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: row;
      -ms-flex-direction: row;
          flex-direction: row;
  -webkit-justify-content: space-between;
      -ms-flex-pack: justify;
          justify-content: space-between;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
}

.coupon-card__rule-text {
  font-size: 22rpx;
  color: #666;
  padding: 10rpx 0;
  line-height: 1;
}

.coupon-card__rule-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
}

/* 新券高亮闪烁 */
/* ===== 新券高亮图层：黄色 50% 透明覆盖层，闪烁 3 次后消失 ===== */
/* 覆盖在券卡内容之上（z-index 高于所有内容） */
/* 动画结束后 opacity 归零并保持，DOM 由 isFlashing 状态清除时移除 */
.coupon-card__flash-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 200, 0, 0.5);
  pointer-events: none;
  z-index: 10;
  -webkit-animation: couponCardFlash 2s ease-in-out 2 forwards;
          animation: couponCardFlash 2s ease-in-out 2 forwards;
}

@-webkit-keyframes couponCardFlash {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 0.65;
  }
  100% {
    opacity: 0;
  }
}

@keyframes couponCardFlash {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 0.65;
  }
  100% {
    opacity: 0;
  }
}
/* ===== Footer ===== */
.coupon-center__footer {
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #f0f0f0;
  z-index: 9999;
  -webkit-flex-shrink: 0;
      -ms-flex-negative: 0;
          flex-shrink: 0;
}

.coupon-center__receive-btn {
  width: 100%;
  height: 88rpx;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  background: -webkit-gradient(linear, left top, right top, from(#ff6b81), to(#ff4d6d));
  background: -webkit-linear-gradient(left, #ff6b81, #ff4d6d);
  background: linear-gradient(90deg, #ff6b81, #ff4d6d);
  border-radius: 44rpx;
  -webkit-box-shadow: 0 6rpx 20rpx 0 rgba(255, 77, 109, 0.3);
          box-shadow: 0 6rpx 20rpx 0 rgba(255, 77, 109, 0.3);
}

.coupon-center__receive-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ===== pack 点击放大动画（0.2s） ===== */
.coupon-pack--zoom {
  -webkit-animation: packZoom 0.2s ease-out forwards;
          animation: packZoom 0.2s ease-out forwards;
  -webkit-transform-origin: center center;
      -ms-transform-origin: center center;
          transform-origin: center center;
}

@-webkit-keyframes packZoom {
  0% {
    -webkit-transform: scale(1);
            transform: scale(1);
  }
  50% {
    -webkit-transform: scale(1.04);
            transform: scale(1.04);
  }
  100% {
    -webkit-transform: scale(1);
            transform: scale(1);
  }
}

@keyframes packZoom {
  0% {
    -webkit-transform: scale(1);
            transform: scale(1);
  }
  50% {
    -webkit-transform: scale(1.04);
            transform: scale(1.04);
  }
  100% {
    -webkit-transform: scale(1);
            transform: scale(1);
  }
}
/* ===== pack 领取后消失动画（0.5s） ===== */
/* 缩小 + 淡出 + 透明度归零，配合 fly-cards 从中心飞出 */
.coupon-pack--leaving {
  -webkit-animation: packLeaving 0.5s ease-in forwards;
          animation: packLeaving 0.5s ease-in forwards;
  -webkit-transform-origin: center center;
      -ms-transform-origin: center center;
          transform-origin: center center;
  pointer-events: none;
}

@-webkit-keyframes packLeaving {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

@keyframes packLeaving {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
/* ===== 抛物线红包卡片层 ===== */
/* 挂在 lightbox 内，absolute 覆盖整个 lightbox */
/* 每张卡片的位置、缩放、旋转、透明度由 JS 逐帧更新 inline style */
.fly-cards {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: visible;
  z-index: 999;
}

.fly-cards__item {
  position: absolute;
  width: 60rpx;
  height: 80rpx;
  /* 位置由 inline style 直接控制（left/top + transform） */
  will-change: transform, opacity;
}

.fly-cards__img {
  width: 60rpx;
  height: 80rpx;
  display: block;
}

/* ===== 新券幻灯片入场动画（由下向上滑入 + 淡入，400ms） ===== */
/* 新券插入时 isFlashing=true（闪烁图层），此时也加 slide-in 类 */
/* 动画结束后 opacity=1 + translateY(0) 保持 */
.coupon-card--slide-in {
  -webkit-animation: couponCardSlideIn 400ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
          animation: couponCardSlideIn 400ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  -webkit-transform-origin: center center;
      -ms-transform-origin: center center;
          transform-origin: center center;
}

@-webkit-keyframes couponCardSlideIn {
  0% {
    -webkit-transform: translateY(120rpx);
            transform: translateY(120rpx);
    opacity: 0;
  }
  100% {
    -webkit-transform: translateY(0);
            transform: translateY(0);
    opacity: 1;
  }
}

@keyframes couponCardSlideIn {
  0% {
    -webkit-transform: translateY(120rpx);
            transform: translateY(120rpx);
    opacity: 0;
  }
  100% {
    -webkit-transform: translateY(0);
            transform: translateY(0);
    opacity: 1;
  }
}
